# LLM Configuration (required for AI features; heuristic fallback used when unset)
LLM_PROVIDER=openai
# Optional: set a real key for LLM-powered analysis (leave empty for fast heuristic mode)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
MAX_FILES=5000
ANALYSIS_TIMEOUT_SECONDS=120

# AI limits (lower = faster; heuristic mode ignores LLM)
AI_MAX_EXPLAIN_FILES=10
AI_MAX_TEST_FILES=3
AI_MAX_MODERNIZE_FILES=3
LLM_TIMEOUT_SECONDS=25
LLM_MAX_CONCURRENCY=3

# GitHub
GITHUB_API_BASE=https://api.github.com
# Optional: avoids GitHub API rate limits for repo downloads
GITHUB_TOKEN=
